#!/bin/bash
# Omarchy hook: post-update — runs at the end of `omarchy update`, after
# migrations. Omarchy has revoked its sudo timestamp by now, so any repair
# below asks for authorization; each one only runs when something drifted.
# No-op on machines without the EgisTec SDCP driver.

pacman -Q libfprint-egismoc-sdcp-git &>/dev/null || {
  # Driver missing on EgisTec hardware (e.g. replaced by libfprint-git): the
  # check sends a clickable "reinstall" notification. Silent elsewhere.
  [[ -x $HOME/.local/bin/egismoc-fingerprint ]] && "$HOME/.local/bin/egismoc-fingerprint" check
  exit 0
}

# IgnorePkg: same logic Omarchy runs before `omarchy refresh pacman`.
bash "$(dirname "$0")/../pre-refresh-pacman.d/lock-driver.hook"

# Lock screen PAM: keep fprintd from timing out into a driver crash loop.
if [[ -f /etc/pam.d/omarchy-lock-fingerprint ]] && ! grep -q "timeout=-1" /etc/pam.d/omarchy-lock-fingerprint; then
  sudo sed -i 's/pam_fprintd\.so.*/pam_fprintd.so timeout=-1 max-tries=-1/' /etc/pam.d/omarchy-lock-fingerprint
fi

# Lid-closed gate: a migration may re-add it without quiet_log.
for pam_file in /etc/pam.d/sudo /etc/pam.d/polkit-1; do
  if [[ -f $pam_file ]] && grep -q 'omarchy-hw-laptop-closed' "$pam_file" && ! grep -q 'quiet_log' "$pam_file"; then
    sudo sed -i 's#pam_exec\.so quiet /usr/bin/omarchy-hw-laptop-closed#pam_exec.so quiet quiet_log /usr/bin/omarchy-hw-laptop-closed#' "$pam_file"
  fi
done

# Lock screen (no sudo): if this update changed Omarchy's lock screen, rebuild
# the cloned copy from it and re-apply the fingerprint retry delay.
[[ -x $HOME/.local/bin/egismoc-fingerprint ]] && "$HOME/.local/bin/egismoc-fingerprint" check
exit 0
